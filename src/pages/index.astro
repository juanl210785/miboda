---
import "../styles/global.css";

const fechaBoda = "2026-12-13T00:00:00";
const novios = "Juan Luis y Wlaismar";
---

<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, viewport-fit=cover"
        />
        <title>Nuestra Boda | {novios}</title>
        <!-- Fuentes de Google Fonts -->
        <link
            href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap"
            rel="stylesheet"
        />
        <style>
            .font-script {
                font-family: "Great Vibes", cursive;
            }
            body {
                font-family: "Plus Jakarta Sans", sans-serif;
            }

            /* Estilos para la animación de scroll */
            .reveal {
                opacity: 0;
                transform: translateY(40px);
                transition:
                    opacity 0.8s ease-out,
                    transform 0.8s ease-out;
                will-change: opacity, transform;
            }
            .reveal.active {
                opacity: 1;
                transform: translateY(0);
            }

            /* Animación mensaje éxito */
            @keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(25px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .animate-fade-in-up {
                animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            }

            .safe-bottom-right {
                bottom: calc(1rem + env(safe-area-inset-bottom));
                right: calc(1rem + env(safe-area-inset-right));
            }
        </style>
        <script
            src="https://cdn.jsdelivr.net/npm/heic2any@0.0.4/dist/heic2any.min.js"
        ></script>
    </head>

    <body class="bg-stone-50 text-stone-800 antialiased selection:bg-amber-200">
        <!-- 1. HERO SECTION -->
        <header
            class="relative h-dvh flex flex-col items-center justify-between pt-8 pb-12 px-6 text-center bg-stone-900 text-white overflow-hidden"
        >
            <div
                class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=1000&auto=format&fit=crop')] bg-cover bg-center opacity-40"
            >
            </div>

            <!-- REPRODUCTOR DE MÚSICA FLOTANTE -->
            <audio id="bg-music" loop>
                <source src="/music.mp3" type="audio/mpeg" />
                Tu navegador no soporta audio.
            </audio>

            <button
                id="music-toggle"
                class="fixed safe-bottom-right z-50 bg-white/90 backdrop-blur-md border border-amber-300 shadow-md text-stone-800 px-3 py-1.5 rounded-full flex items-center gap-1.5 text-[10px] sm:text-xs font-semibold uppercase tracking-wider hover:bg-amber-100 transition-all duration-300 cursor-pointer"
            >
                <span id="music-icon" class="text-xs">🎵</span>
                <span id="music-text">Música: Off</span>
            </button>

            <div class="relative z-10 space-y-2 reveal pt-4">
                <p
                    class="uppercase tracking-widest text-xs text-amber-200 font-medium"
                >
                    Nuestra Boda
                </p>
                <h1 class="font-script text-6xl md:text-7xl text-amber-100">
                    {novios}
                </h1>
            </div>

            <div class="relative z-10 space-y-4 my-auto reveal">
                <p class="text-lg font-light tracking-wide">
                    20 de Diciembre de 2026
                </p>
                <div class="w-16 h-[1px] bg-amber-200/50 mx-auto"></div>
                <p class="text-sm italic text-stone-300 max-w-xs mx-auto">
                    "...El cordón de tres hilos no se rompe fácilmente."
                </p>
            </div>

            <div class="relative z-10 reveal pb-2">
                <a
                    id="open-invitation"
                    href="#historia"
                    class="inline-block px-8 py-3 rounded-full border border-amber-200/60 text-amber-100 text-sm tracking-wider uppercase hover:bg-amber-100 hover:text-stone-900 transition duration-300 cursor-pointer shadow-lg bg-stone-900/40 backdrop-blur-sm"
                >
                    Abrir Invitación
                </a>
            </div>
        </header>

        <!-- 2. HISTORIA / BIENVENIDA -->
        <section
            id="historia"
            class="py-20 px-6 max-w-md mx-auto text-center space-y-6 reveal"
        >
            <h2 class="font-script text-4xl text-stone-700">¡Nos Casamos!</h2>
            <p class="text-stone-600 leading-relaxed text-sm">
                Hay momentos en la vida que son inolvidables, y compartirlos con
                quienes amamos los hace eternos. Queremos que formes parte de
                este gran día en el que uniremos nuestras vidas para siempre.
            </p>
        </section>

        <!-- 3. CUENTA REGRESIVA -->
        <section class="py-12 bg-stone-200/60 px-6 text-center reveal">
            <h3
                class="text-xs uppercase tracking-widest text-stone-500 mb-6 font-semibold"
            >
                Faltan
            </h3>
            <div class="flex justify-center gap-4 text-stone-800">
                <div class="bg-white p-3 rounded-lg shadow-sm w-16">
                    <span id="days" class="block text-2xl font-bold">00</span>
                    <span class="text-[10px] uppercase text-stone-400"
                        >Días</span
                    >
                </div>
                <div class="bg-white p-3 rounded-lg shadow-sm w-16">
                    <span id="hours" class="block text-2xl font-bold">00</span>
                    <span class="text-[10px] uppercase text-stone-400"
                        >Horas</span
                    >
                </div>
                <div class="bg-white p-3 rounded-lg shadow-sm w-16">
                    <span id="minutes" class="block text-2xl font-bold">00</span
                    >
                    <span class="text-[10px] uppercase text-stone-400">Min</span
                    >
                </div>
                <div class="bg-white p-3 rounded-lg shadow-sm w-16">
                    <span id="seconds" class="block text-2xl font-bold">00</span
                    >
                    <span class="text-[10px] uppercase text-stone-400">Seg</span
                    >
                </div>
            </div>
        </section>

        <!-- 4. ITINERARIO Y UBICACIÓN -->
        <section class="py-20 px-6 max-w-md mx-auto space-y-12">
            <div class="text-center space-y-2 reveal">
                <h2 class="font-script text-4xl text-stone-700">
                    ¿Dónde y Cuándo?
                </h2>
                <p class="text-xs uppercase tracking-widest text-stone-400">
                    Ceremonia y Recepción
                </p>
            </div>

            <!-- Tarjeta Ceremonia -->
            <div
                class="bg-white p-6 rounded-2xl shadow-sm border border-stone-100 text-center space-y-4 reveal"
            >
                <div
                    class="w-12 h-12 bg-amber-50 rounded-full flex items-center justify-center mx-auto text-amber-700 font-bold"
                >
                    ⛪ 🥂
                </div>
                <h3 class="font-semibold text-lg">
                    Ceremonia Religiosa y Recepción
                </h3>
                <p class="text-sm text-stone-500">
                    Parroquia San Antonio de Padua<br />16:00 hrs
                </p>
                <a
                    href="https://maps.app.goo.gl/bqc5jVs1nmSHEvYw7"
                    target="_blank"
                    class="inline-block text-xs font-semibold uppercase tracking-wider text-amber-800 bg-amber-50 px-4 py-2 rounded-full hover:bg-amber-100 transition"
                >
                    Ver Ubicación GPS
                </a>
            </div>
        </section>

        <!-- 5. DRESS CODE Y REGALOS -->
        <section class="py-16 bg-stone-100 px-6 text-center space-y-10">
            <div class="max-w-md mx-auto space-y-2 reveal">
                <h2 class="font-script text-4xl text-stone-700">
                    Detalles Importantes
                </h2>
            </div>

            <!-- Dress Code -->
            <div
                class="max-w-md mx-auto bg-white p-6 rounded-2xl shadow-sm space-y-3 reveal"
            >
                <div class="text-2xl">👔</div>
                <h3 class="font-semibold text-base">Código de Vestimenta</h3>
                <p class="text-sm text-stone-600 font-medium">
                    Rigurosa Etiqueta / Formal
                </p>
                <p class="text-xs text-stone-400">
                    Sugerencia de color: EVITAR TONOS CHAMPAGNE O MARFIL.
                </p>
            </div>

            <!-- Regalos / Lluvia de Sobres -->
            <div
                class="max-w-md mx-auto bg-white p-6 rounded-2xl shadow-sm space-y-4 reveal"
            >
                <div class="text-2xl">🎁</div>
                <h3 class="font-semibold text-base">Mesa de Regalos</h3>
                <p class="text-sm text-stone-600">
                    "El mejor regalo es tu presencia, pero si deseas tener un
                    detalle para ayudarnos a construir nuestro nuevo hogar,
                    puedes hacerlo mediante pago movíl, divisas, binance o
                    código QR:"
                </p>

                <!-- Datos Bancarios -->
                <div
                    class="bg-stone-50 p-4 rounded-xl text-left text-xs space-y-1 text-stone-600 border border-stone-200"
                >
                    <p><strong>Banco:</strong> Venezuela</p>
                    <p><strong>Teléfono:</strong> 04243662542</p>
                    <p><strong>C.I:</strong> 17062239</p>
                </div>

                <!-- Código QR -->
                <div class="pt-2">
                    <div
                        class="w-32 h-32 mx-auto bg-stone-200 rounded-lg flex items-center justify-center text-xs text-stone-500 border border-dashed border-stone-400"
                    >
                        <img
                            src="/QR_code.jpg"
                            alt="Código QR de la boda"
                            class=""
                        />
                    </div>
                    <span class="text-[10px] text-stone-400 block mt-2"
                        >Escanea para transferir directo</span
                    >
                </div>
            </div>
        </section>

        <!-- 6. FORMULARIO RSVP -->
        <section class="py-20 px-6 max-w-md mx-auto space-y-6 reveal">
            <div class="text-center space-y-2">
                <h2 class="font-script text-4xl text-stone-700">
                    Confirmación
                </h2>
                <p class="text-xs uppercase tracking-widest text-stone-400">
                    Responder antes del 20 de Noviembre
                </p>
            </div>

            <!-- Formulario de RSVP -->
            <form
                id="rsvp-form"
                class="bg-white p-6 rounded-2xl shadow-sm border border-stone-100 space-y-4"
            >
                <div>
                    <label
                        class="block text-xs font-semibold uppercase text-stone-600 mb-1"
                        >Nombre Completo</label
                    >
                    <input
                        type="text"
                        name="nombre"
                        id="nombre"
                        required
                        class="w-full px-4 py-2 border border-stone-200 rounded-lg text-sm"
                        placeholder="Ej. Ana Gómez"
                    />
                </div>

                <div>
                    <label
                        class="block text-xs font-semibold uppercase text-stone-600 mb-1"
                        >¿Asistirás?</label
                    >
                    <select
                        name="asistira"
                        id="asistira"
                        class="w-full px-4 py-2 border border-stone-200 rounded-lg text-sm bg-white"
                    >
                        <option value="Si">Sí, ¡allí estaré!</option>
                        <option value="No">Lo siento, no podré asistir</option>
                    </select>
                </div>

                <div>
                    <label
                        class="block text-xs font-semibold uppercase text-stone-600 mb-1"
                        >Hijos</label
                    >
                    <input
                        type="number"
                        name="pases"
                        id="pases"
                        min="0"
                        max="5"
                        value="0"
                        class="w-full px-4 py-2 border border-stone-200 rounded-lg text-sm"
                    />
                </div>

                <div>
                    <label
                        class="block text-xs font-semibold uppercase text-stone-600 mb-1"
                        >Restricciones Alimentarias (Opcional)</label
                    >
                    <input
                        type="text"
                        name="restricciones"
                        id="restricciones"
                        class="w-full px-4 py-2 border border-stone-200 rounded-lg text-sm"
                        placeholder="Vegetariano, alergias, etc."
                    />
                </div>

                <button
                    type="submit"
                    id="submit-btn"
                    class="w-full py-3 bg-stone-900 text-white rounded-lg text-xs uppercase tracking-wider font-semibold hover:bg-stone-800 transition cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-stone-900"
                >
                    Enviar Confirmación
                </button>
                <p
                    id="form-error-message"
                    class="text-xs text-center hidden mt-2 font-medium text-rose-600"
                >
                    Ocurrió un error. Inténtalo de nuevo.
                </p>
            </form>

            <!-- Mensaje de éxito -->
            <div
                id="success-message"
                class="hidden bg-white p-8 rounded-2xl shadow-sm border border-stone-100 text-center space-y-3 animate-fade-in-up"
            >
                <div class="text-3xl">✨</div>
                <p class="text-stone-700 font-medium text-sm">
                    ¡Muchas gracias! Tu asistencia ha sido registrada.
                </p>
            </div>

            <script>
                const form = document.getElementById("rsvp-form");
                const successMsg = document.getElementById("success-message");
                const errorMsg = document.getElementById("form-error-message");
                const btn = document.getElementById("submit-btn");

                form?.addEventListener("submit", async (e) => {
                    e.preventDefault();
                    btn.disabled = true;
                    btn.innerText = "Enviando...";
                    errorMsg?.classList.add("hidden");

                    const payload = {
                        nombre: document.getElementById("nombre").value,
                        asistira: document.getElementById("asistira").value,
                        pases: document.getElementById("pases").value,
                        restricciones:
                            document.getElementById("restricciones").value,
                    };

                    try {
                        const res = await fetch("/api/rsvp", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify(payload),
                        });

                        if (res.ok) {
                            form.classList.add("hidden");
                            successMsg.classList.remove("hidden");
                        } else {
                            throw new Error("Error al procesar el envío");
                        }
                    } catch (err) {
                        errorMsg?.classList.remove("hidden");
                    } finally {
                        btn.disabled = false;
                        btn.innerText = "Enviar Confirmación";
                    }
                });
            </script>
        </section>

        <!-- SECCIÓN ÁLBUM DE FOTOS Y GALERÍA -->
        <section id="album" class="py-20 px-6 max-w-4xl mx-auto space-y-12">
            <div class="text-center space-y-2 reveal">
                <h2 class="font-script text-4xl text-stone-700">
                    Álbum de Recuerdos
                </h2>
                <p class="text-xs uppercase tracking-widest text-stone-400">
                    Comparte las fotos que tomaste durante nuestro gran día
                </p>
            </div>

            <!-- 1. MÓDULO BLOQUEADO -->
            <div
                id="album-locked-msg"
                class="bg-white p-8 rounded-2xl shadow-sm border border-stone-100 text-center space-y-3 max-w-md mx-auto reveal"
            >
                <div class="text-4xl">📸</div>
                <h3 class="font-semibold text-stone-700 text-base">
                    Álbum aún no activo
                </h3>
                <p class="text-stone-500 text-sm leading-relaxed">
                    El día de la boda se activará el módulo de álbum de fotos
                    para que puedas subir y compartir tus mejores momentos con
                    nosotros.
                </p>
                <span
                    class="inline-block text-[11px] font-medium text-amber-800 bg-amber-50 px-3 py-1 rounded-full border border-amber-200/60"
                >
                    Disponible el 20 de Diciembre de 2026
                </span>
            </div>

            <!-- 2. FORMULARIO PARA SUBIR FOTOS -->
            <form
                id="upload-form"
                class="hidden bg-white p-6 rounded-2xl shadow-sm border border-stone-100 max-w-md mx-auto space-y-4"
            >
                <div>
                    <label
                        class="block text-xs font-semibold uppercase text-stone-600 mb-1"
                        >Tu Nombre</label
                    >
                    <input
                        type="text"
                        id="invitado-nombre"
                        required
                        class="w-full px-4 py-2 border border-stone-200 rounded-lg text-sm"
                        placeholder="Ej. Carlos Mendoza"
                    />
                </div>

                <div>
                    <label
                        class="block text-xs font-semibold uppercase text-stone-600 mb-1"
                        >Selecciona una o varias Fotos</label
                    >
                    <input
                        type="file"
                        id="foto-file"
                        accept="image/*"
                        multiple
                        required
                        class="w-full text-sm text-stone-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-amber-50 file:text-amber-800 hover:file:bg-amber-100"
                    />
                </div>

                <div>
                    <label
                        class="block text-xs font-semibold uppercase text-stone-600 mb-1"
                        >Mensaje o Dedicatoria (Opcional)</label
                    >
                    <textarea
                        id="foto-comentario"
                        class="w-full px-4 py-2 border border-stone-200 rounded-lg text-sm"
                        placeholder="¡Qué gran momento!"></textarea>
                </div>

                <button
                    type="submit"
                    id="btn-upload"
                    class="w-full py-3 bg-stone-900 text-white rounded-lg text-xs uppercase tracking-wider font-semibold hover:bg-stone-800 transition cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-stone-900"
                >
                    Subir Fotos al Álbum
                </button>
                <p
                    id="upload-status"
                    class="text-xs text-center hidden mt-2 font-medium"
                >
                </p>
            </form>

            <!-- 3. CONTENEDOR DE LA GALERÍA DE FOTOS (Oculto si no hay imágenes) -->
            <div
                id="gallery-container"
                class="hidden space-y-6 pt-8 border-t border-stone-200"
            >
                <h3 class="font-script text-3xl text-center text-stone-700">
                    Momentos Compartidos
                </h3>
                <div
                    id="photos-grid"
                    class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4"
                >
                    <!-- Se renderiza dinámicamente -->
                </div>
            </div>
        </section>

        <!-- MODAL / LIGHTBOX PARA AMPLIAR FOTOS -->
        <div
            id="lightbox-modal"
            class="fixed inset-0 z-50 bg-stone-950/90 backdrop-blur-sm hidden flex flex-col items-center justify-center p-4 transition-all duration-300"
        >
            <!-- Botón para cerrar -->
            <button
                id="close-lightbox"
                class="absolute top-4 right-4 text-white/80 hover:text-white bg-white/10 hover:bg-white/20 p-2.5 rounded-full transition text-sm z-10 cursor-pointer"
                aria-label="Cerrar visor"
            >
                ✕
            </button>

            <!-- Contenedor de la Imagen e Información -->
            <div
                class="relative max-w-3xl max-h-[85vh] flex flex-col items-center justify-center overflow-hidden rounded-2xl bg-stone-900/60 border border-white/10 shadow-2xl"
            >
                <img
                    id="lightbox-img"
                    src=""
                    alt="Foto ampliada"
                    class="max-h-[70vh] w-auto object-contain rounded-t-2xl"
                />
                <div
                    id="lightbox-info"
                    class="w-full p-4 text-center bg-stone-900 text-white space-y-1 border-t border-stone-800"
                >
                    <p
                        id="lightbox-author"
                        class="text-sm font-semibold text-amber-200"
                    >
                    </p>
                    <p
                        id="lightbox-comment"
                        class="text-xs text-stone-300 italic"
                    >
                    </p>
                </div>
            </div>
        </div>

        <!-- SCRIPT UNIFICADO ÁLBUM DE FOTOS Y LIGHTBOX -->
        <script define:vars={{ fechaBoda }}>
            const lockedMsg = document.getElementById("album-locked-msg");
            const uploadForm = document.getElementById("upload-form");
            const galleryContainer =
                document.getElementById("gallery-container");
            const photosGrid = document.getElementById("photos-grid");

            // Elementos del Lightbox Modal
            const lightboxModal = document.getElementById("lightbox-modal");
            const lightboxImg = document.getElementById("lightbox-img");
            const lightboxAuthor = document.getElementById("lightbox-author");
            const lightboxComment = document.getElementById("lightbox-comment");
            const closeLightboxBtn = document.getElementById("close-lightbox");

            const weddingDate = new Date(fechaBoda).getTime();
            const now = new Date().getTime();

            const urlParams = new URLSearchParams(window.location.search);
            const isTestMode = urlParams.get("testAlbum") === "true";

            // --- LÓGICA DEL LIGHTBOX (VISOR) ---
            function openLightbox(url, nombre, comentario) {
                if (!lightboxModal || !lightboxImg) return;
                lightboxImg.src = url;
                lightboxAuthor.innerText = nombre
                    ? `Subida por: ${nombre}`
                    : "Invitado";
                lightboxComment.innerText = comentario ? `"${comentario}"` : "";
                lightboxModal.classList.remove("hidden");
                document.body.style.overflow = "hidden"; // Desactiva scroll
            }

            function closeLightbox() {
                if (!lightboxModal || !lightboxImg) return;
                lightboxModal.classList.add("hidden");
                lightboxImg.src = "";
                document.body.style.overflow = ""; // Restaura scroll
            }

            closeLightboxBtn?.addEventListener("click", closeLightbox);

            lightboxModal?.addEventListener("click", (e) => {
                if (e.target === lightboxModal) closeLightbox();
            });

            document.addEventListener("keydown", (e) => {
                if (
                    e.key === "Escape" &&
                    lightboxModal &&
                    !lightboxModal.classList.contains("hidden")
                ) {
                    closeLightbox();
                }
            });

            photosGrid?.addEventListener("click", (e) => {
                const photoCard = e.target.closest(".photo-card");
                if (!photoCard) return;

                const url = photoCard.dataset.url;
                const nombre = photoCard.dataset.nombre;
                const comentario = photoCard.dataset.comentario;

                openLightbox(url, nombre, comentario);
            });

            // 1. OBTENER Y MOSTRAR FOTOS
            async function loadGallery() {
                try {
                    const res = await fetch("/api/photos");
                    if (!res.ok) return;

                    const photos = await res.json();

                    if (Array.isArray(photos) && photos.length > 0) {
                        photosGrid.innerHTML = photos
                            .map(
                                (photo) => `
            <div 
                class="photo-card group relative aspect-square overflow-hidden rounded-xl bg-stone-200 shadow-sm cursor-pointer"
                data-url="${photo.url}"
                data-nombre="${photo.nombre_invitado || "Invitado"}"
                data-comentario="${photo.comentario || ""}"
            >
                <img
                    src="${photo.url}"
                    alt="Foto por ${photo.nombre_invitado || "Invitado"}"
                    class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                    loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-3 text-white">
                    <p class="text-xs font-semibold">${photo.nombre_invitado || "Invitado"}</p>
                    ${photo.comentario ? `<p class="text-[10px] text-stone-200 line-clamp-2">${photo.comentario}</p>` : ""}
                </div>
            </div>
        `,
                            )
                            .join("");

                        galleryContainer?.classList.remove("hidden");
                    } else {
                        galleryContainer?.classList.add("hidden");
                    }
                } catch (err) {
                    console.log(
                        "No hay fotos para mostrar o no se pudo cargar la galería.",
                    );
                }
            }

            // Carga inicial
            loadGallery();

            // Desbloquear módulo de subida
            if (now >= weddingDate || isTestMode) {
                lockedMsg?.classList.add("hidden");
                uploadForm?.classList.remove("hidden");
            }

            // 2. SUBIDA DE FOTOS (UNA POR UNA, MÁXIMO 5)
            const uploadStatus = document.getElementById("upload-status");
            const btnUpload = document.getElementById("btn-upload");
            const MAX_PHOTOS = 5;

            uploadForm?.addEventListener("submit", async (e) => {
                e.preventDefault();

                const nombre = document.getElementById("invitado-nombre").value;
                const fileInput = document.getElementById("foto-file");
                const comentario =
                    document.getElementById("foto-comentario").value;

                if (!fileInput.files || fileInput.files.length === 0) return;

                const filesArray = Array.from(fileInput.files);

                // Validar límite de 5 imágenes
                if (filesArray.length > MAX_PHOTOS) {
                    uploadStatus.innerText = `Solo puedes subir un máximo de ${MAX_PHOTOS} fotos a la vez.`;
                    uploadStatus.className =
                        "text-xs text-center mt-2 font-medium text-rose-600 block";
                    uploadStatus.classList.remove("hidden");
                    return;
                }

                // Bloquear botón y ocultar mensajes previos
                btnUpload.disabled = true;
                uploadStatus?.classList.add("hidden");

                let successCount = 0;
                let errorCount = 0;

                // Iterar y enviar cada imagen por separado
                for (let i = 0; i < filesArray.length; i++) {
                    const file = filesArray[i];
                    const currentStep = i + 1;
                    let fileToUpload = file;

                    btnUpload.innerText = `Procesando ${currentStep} de ${filesArray.length}...`;

                    // Detectar y convertir formato HEIC / HEIF si aplica
                    const isHeic =
                        file.name.toLowerCase().endsWith(".heic") ||
                        file.name.toLowerCase().endsWith(".heif") ||
                        file.type === "image/heic" ||
                        file.type === "image/heif";

                    if (isHeic && typeof heic2any !== "undefined") {
                        try {
                            btnUpload.innerText = `Convirtiendo HEIC (${currentStep}/${filesArray.length})...`;
                            const convertedBlob = await heic2any({
                                blob: file,
                                toType: "image/jpeg",
                                quality: 0.8,
                            });

                            const convertedFile = Array.isArray(convertedBlob)
                                ? convertedBlob[0]
                                : convertedBlob;

                            fileToUpload = new File(
                                [convertedFile],
                                file.name.replace(/\.(heic|heif)$/i, ".jpg"),
                                { type: "image/jpeg" },
                            );
                        } catch (convErr) {
                            console.error(
                                "Error al convertir imagen HEIC:",
                                convErr,
                            );
                        }
                    }

                    // Crear FormData individual para esta única imagen
                    const formData = new FormData();
                    formData.append("photos", fileToUpload);
                    formData.append("nombre", nombre);
                    formData.append("comentario", comentario);

                    btnUpload.innerText = `Subiendo ${currentStep} de ${filesArray.length}...`;

                    try {
                        const response = await fetch("/api/upload-photo", {
                            method: "POST",
                            body: formData,
                        });

                        if (response.ok) {
                            successCount++;
                        } else {
                            errorCount++;
                        }
                    } catch (err) {
                        errorCount++;
                    }
                }

                // Feedback al usuario según resultados
                if (errorCount === 0) {
                    uploadStatus.innerText =
                        filesArray.length > 1
                            ? "¡Todas las fotos fueron subidas con éxito!"
                            : "¡Foto subida con éxito!";
                    uploadStatus.className =
                        "text-xs text-center mt-2 font-medium text-emerald-600 block";
                    uploadForm.reset();
                } else if (successCount > 0) {
                    uploadStatus.innerText = `Se subieron ${successCount} fotos, pero ${errorCount} fallaron.`;
                    uploadStatus.className =
                        "text-xs text-center mt-2 font-medium text-amber-600 block";
                } else {
                    uploadStatus.innerText =
                        "Ocurrió un error al subir las fotos.";
                    uploadStatus.className =
                        "text-xs text-center mt-2 font-medium text-rose-600 block";
                }

                // Recargar la galería al terminar
                await loadGallery();

                // Restablecer botón
                btnUpload.disabled = false;
                btnUpload.innerText = "Subir Fotos al Álbum";
            });
        </script>

        <!-- 7. FOOTER -->
        <footer
            class="py-10 bg-stone-900 text-stone-400 text-center text-xs space-y-2 reveal"
        >
            <p class="font-script text-2xl text-amber-100">{novios}</p>
            <p>© 2026 - Con mucho amor</p>
        </footer>

        <!-- SCRIPT ANIMACIONES SCROLL -->
        <script>
            const observerOptions = {
                root: null,
                threshold: 0.15,
            };

            const observer = new IntersectionObserver((entries, obs) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("active");
                        obs.unobserve(entry.target);
                    }
                });
            }, observerOptions);

            document
                .querySelectorAll(".reveal")
                .forEach((el) => observer.observe(el));
        </script>

        <!-- SCRIPT CUENTA REGRESIVA -->
        <script define:vars={{ fechaBoda }}>
            const countdownDate = new Date(fechaBoda).getTime();

            function updateCountdown() {
                const now = new Date().getTime();
                const distance = countdownDate - now;

                if (distance < 0) return;

                const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                const hours = Math.floor(
                    (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
                );
                const minutes = Math.floor(
                    (distance % (1000 * 60 * 60)) / (1000 * 60),
                );
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                document.getElementById("days").innerText = String(
                    days,
                ).padStart(2, "0");
                document.getElementById("hours").innerText = String(
                    hours,
                ).padStart(2, "0");
                document.getElementById("minutes").innerText = String(
                    minutes,
                ).padStart(2, "0");
                document.getElementById("seconds").innerText = String(
                    seconds,
                ).padStart(2, "0");
            }

            setInterval(updateCountdown, 1000);
            updateCountdown();
        </script>

        <!-- SCRIPT CONTROL MÚSICA -->
        <script>
            const music = document.getElementById("bg-music");
            const toggleBtn = document.getElementById("music-toggle");
            const openBtn = document.getElementById("open-invitation");
            const musicIcon = document.getElementById("music-icon");
            const musicText = document.getElementById("music-text");
            let isPlaying = false;

            function playMusic() {
                music
                    .play()
                    .then(() => {
                        isPlaying = true;
                        musicIcon.innerText = "🎶";
                        musicText.innerText = "Música: On";
                        toggleBtn.classList.add(
                            "bg-amber-100",
                            "border-amber-400",
                        );
                    })
                    .catch((error) => {
                        console.log("Error al reproducir audio:", error);
                    });
            }

            function pauseMusic() {
                music.pause();
                isPlaying = false;
                musicIcon.innerText = "🎵";
                musicText.innerText = "Música: Off";
                toggleBtn.classList.remove("bg-amber-100", "border-amber-400");
            }

            openBtn?.addEventListener("click", () => {
                if (!isPlaying) {
                    playMusic();
                }
            });

            toggleBtn?.addEventListener("click", () => {
                if (isPlaying) {
                    pauseMusic();
                } else {
                    playMusic();
                }
            });
        </script>
    </body>
</html>
